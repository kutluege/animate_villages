 ],
 "sentences": [
  {
   "text": "Burası neresi?",
   "start": 0.12,
   "end": 0.71,
   "w0": 0,
   "w1": 1,
   "clip": "1.mp3"
  },
  {
   "text": "Tanıyabildiniz mi?",
   "start": 0.71,
   "end": 1.56,
   "w0": 2,
   "w1": 3,
   "clip": "1.mp3"
  },
  {
   "text": "Bir dakika ya.",
   "start": 2.781,
   "end": 3.5,
   "w0": 4,
   "w1": 6,
   "clip": "1.mp3"
  },
  {
   "text": "Burası çok tanıdık.",
   "start": 4.03,
   "end": 4.709,
   "w0": 7,
   "w1": 9,
   "clip": "1.mp3"
  },
  {
   "text": "Evet, burası her gün yüz binlerce insanın geçtiği Mecidiyeköy.",
   "start": 5.757,
   "end": 9.19,
   "w0": 10,
   "w1": 18,
   "clip": "1.mp3"
  },
  {
   "text": "Bu güzel ve kaotik semtin simülasyonunu Claude Code kullanarak gerçekleştirdim.",
   "start": 9.69,
   "end": 13.572,
   "w0": 19,
   "w1": 28,
   "clip": "2.mp3"
  },
  {
   "text": "Üstelik bunu nasıl yaptığım, ortaya çıkan sonuç kadar ilginç.",
   "start": 14.524,
   "end": 17.172,
   "w0": 29,
   "w1": 37,
   "clip": "2.mp3"
  },
  {
   "text": "Sonucu görmek için videonun sonuna kadar bekle.",
   "start": 17.846,
   "end": 19.641,
   "w0": 38,
   "w1": 44,
   "clip": "2.mp3"
  },
  {
   "text": "Bunu yaparken tek bir sohbette, tek bir modelle yazdırmadım.",
   "start": 20.333,
   "end": 23.881,
   "w0": 45,
   "w1": 53,
   "clip": "3.mp3"
  },
  {
   "text": "Çünkü iş büyüdükçe, bildiğiniz gibi, modelin bağlamı şişer.",
   "start": 24.519,
   "end": 27.294,
   "w0": 54,
   "w1": 61,
   "clip": "3.mp3"
  },
  {
   "text": "Bağlam şiştikçe de model saçmalamaya başlar.",
   "start": 27.314,
   "end": 29.854,
   "w0": 62,
   "w1": 67,
   "clip": "3.mp3"
  },
  {
   "text": "Onun yerine bir ekip kurdum.",
   "start": 30.38,
   "end": 31.654,
   "w0": 68,
   "w1": 72,
   "clip": "3.mp3"
  },
  {
   "text": "Yönetici model işi böldü: veri, şehir, kuleler, ışık ve kamera görevlerini ayrı ayrı ajanlara verdi.",
   "start": 32.38,
   "end": 37.714,
   "w0": 73,
   "w1": 87,
   "clip": "3.mp3"
  },
  {
   "text": "Her ajan yalnızca kendi işine odaklandı ve yöneticisine kısa bir rapor sundu.",
   "start": 38.377,
   "end": 42.514,
   "w0": 88,
   "w1": 99,
   "clip": "3.mp3"
  },
  {
   "text": "Size de tavsiyem: siz de büyük işlerde böyle çalışın.",
   "start": 43.105,
   "end": 46.56,
   "w0": 100,
   "w1": 108,
   "clip": "4.mp3"
  },
  {
   "text": "İşi bölün, yöneticinin bağlamını temiz tutun.",
   "start": 47.014,
   "end": 49.42,
   "w0": 109,
   "w1": 114,
   "clip": "4.mp3"
  },
  {
   "text": "Kendinizi bunu yaparken bir ordu grubunu yöneten bir başkomutan gibi düşünebilirsiniz.",
   "start": 50.3,
   "end": 54.08,
   "w0": 115,
   "w1": 125,
   "clip": "4.mp3"
  },
  {
   "text": "Ana ajanınız bir mareşal olsun ve emrine yönetebileceği ordular verin.",
   "start": 55.08,
   "end": 58.94,
   "w0": 126,
   "w1": 135,
   "clip": "4.mp3"
  },
  {
   "text": "Peki, normalde yazılımcılara yaptırabileceğiniz böyle bir simülasyonu modeller nasıl yapıyor?",
   "start": 59.456,
   "end": 64.654,
   "w0": 136,
   "w1": 145,
   "clip": "5.mp3"
  },
  {
   "text": "Modeller aslında bu tarz görüntü içeren işleri kare kare üretiyor ilk başta.",
   "start": 65.858,
   "end": 69.394,
   "w0": 146,
   "w1": 157,
   "clip": "5.mp3"
  },
  {
   "text": "Sonrasında ise kendi ürettikleri kareleri inceleyerek ilerliyor.",
   "start": 70.172,
   "end": 73.218,
   "w0": 158,
   "w1": 164,
   "clip": "5.mp3"
  },
  {
   "text": "Bu aslında çok şaşırtıcı.",
   "start": 73.851,
   "end": 75.074,
   "w0": 165,
   "w1": 168,
   "clip": "5.mp3"
  },
  {
   "text": "Konuyu bilenler, ajan orkestrasyonda farklı modelleri general, farklı modelleri ise oradaki askerler olarak kullanabiliyor.",
   "start": 76.001,
   "end": 82.374,
   "w0": 169,
   "w1": 182,
   "clip": "5.mp3"
  },
  {
   "text": "Bense burada iki farklı senaryoyu da denedim.",
   "start": 83.455,
   "end": 85.254,
   "w0": 183,
   "w1": 189,
   "clip": "5.mp3"
  },
  {
   "text": "İlkinde Opus'u general yaptım, Fable askerdi.",
   "start": 86.143,
   "end": 88.554,
   "w0": 190,
   "w1": 195,
   "clip": "5.mp3"
  },
  {
   "text": "İkincisini de tam tersini yaptım: Fable general, Opus ise askerdi.",
   "start": 88.694,
   "end": 92.014,
   "w0": 196,
   "w1": 205,
   "clip": "5.mp3"
  },
  {
   "text": "Sonuç ne mi oldu?",
   "start": 92.905,
   "end": 93.554,
   "w0": 206,
   "w1": 209,
   "clip": "5.mp3"
  },
  {
   "text": "Bana göre kazanan açık: Fable'ın yönettiği ekip çok daha iyi bir sonuç ortaya çıkarttı.",
   "start": 94.469,
   "end": 98.348,
   "w0": 210,
   "w1": 223,
   "clip": "5.mp3"
  },
  {
   "text": "Burada sonuçlardan şunu söylemem mümkün.",
   "start": 98.923,
   "end": 100.927,
   "w0": 224,
   "w1": 228,
   "clip": "6.mp3"
  },
  {
   "text": "Size de akışlarınızda Fable'ın general, Opus'un asker olduğu senaryoyu öneriyorum.",
   "start": 101.878,
   "end": 106.387,
   "w0": 229,
   "w1": 238,
   "clip": "6.mp3"
  },
  {
   "text": "Ayrıca Fable'ın yönettiği Opus ekibi bu işi 90 dolara yaparken, Opus'un yönettiği Fable ordusu bu işi 150 dolara yaptı.",
   "start": 107.361,
   "end": 113.607,
   "w0": 239,
   "w1": 257,
   "clip": "6.mp3"
  },
  {
   "text": "Bu açıdan da iş akışlarınızı gözden geçirmenizi tavsiye ediyorum ve sizi şimdi sonuçla baş başa bırakıyorum.",
   "start": 114.129,
   "end": 119.159,
   "w0": 258,
   "w1": 273,
   "clip": "7.mp3"
  }
